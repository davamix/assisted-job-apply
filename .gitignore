output/*
!output/README.md

# Database (personal job history)
data/*.db
data/*.sqlite
data/*.sqlite3

# Playwright artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
